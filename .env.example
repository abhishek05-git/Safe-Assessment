# SAFE Assessment - Server Environment Configuration (.env.example)
# Copy this file to .env and fill in your secrets. NEVER commit the real .env file.

# 1. Server Network Binding
# Private host (binds to localhost only so external internet cannot reach Node port directly)
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# 2. Session Cryptographic Secret (Minimum 32 random characters)
SESSION_SECRET=replace_with_long_random_session_secret_at_least_32_characters

# 3. OTP Pepper (Separate secret used for HMAC-SHA256 OTP hashing)
OTP_PEPPER=replace_with_separate_long_random_otp_pepper_secret

# 4. Admin Password Bcrypt Hash
# Generate using: node server/scripts/hashPassword.js "YourStrongPassword"
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash_of_admin_password

# 5. Google Sheets Private Apps Script Integration
# Private backend URL and shared token (Validated on every call inside Apps Script)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
GOOGLE_SCRIPT_SHARED_SECRET=replace_with_strong_shared_secret_token

# 6. Direct SMTP Email Dispatch (Alternative to Google Apps Script MailApp)
# Supports Hostinger SMTP, Gmail (with 16-character App Password), or any SMTP service
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_email_or_app_password
SMTP_FROM="SAFE Assessment" <noreply@yourdomain.com>

